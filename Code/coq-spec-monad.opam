opam-version: "2.0"
maintainer: "anonymous"
version: "dev"

license: "MIT"

synopsis: "The Coq formalization of spec monads"
description: "Theory for spec monads, Hoare logic, and incorrectness logic."

build: [
  [make "-j%{jobs}%" "all"]
]
install: [make "install"]
run-test: [make "check"]
depends: [
  "coq" {>= "8.20"}
  "coq-hammer-tactics" {>= "1.3.2"}
  "coq-ext-lib" {>= "0.13.0"}
  "coq-itree" {>= "5.2.1"}
  "coq-itree-extra" {>= "5.2.1"}
]

tags: []

authors: [
  "Anonymous"
]
