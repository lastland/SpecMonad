      destruct (runStateT m s) as [[outcomes]].
      intros oa Hoa. specialize (H oa Hoa). destruct oa as [r|]; [|exact I].
      exact (Hsub r H).
    - intros H s Hpre.
      apply (H s post). split; [exact Hpre | intros r hr; exact hr].
  Qed.

